# Insurance Intelligence Frontend — Environment Variables
# Copy this file to .env or .env.production and configure accordingly.

# Backend API base URL
# Local Development: http://127.0.0.1:8000
# Production Deployment: https://api.yourdomain.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to 'false' to connect to genuine FastAPI backend and machine learning pipeline
# Set to 'true' only for offline UI presentation / mock evaluation
VITE_USE_MOCK=false

# Application name shown in navigation and title
VITE_APP_NAME=Insurance Intelligence
